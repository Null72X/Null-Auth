# Null-Auth Backend Environment Configuration

PORT=5000
NODE_ENV=production

# Supabase PostgreSQL Connection URL (Requires sslmode=require for serverless Vercel)
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require"

# Admin Authentication Secrets
JWT_SECRET=null_auth_jwt_super_secret_key_987654321
JWT_EXPIRES_IN=24h

# Initial Admin Credentials
INITIAL_ADMIN_USERNAME=NULL
INITIAL_ADMIN_PASSWORD=NULLX500Y

# CORS Configuration
CORS_ORIGIN=https://null-auth.vercel.app
