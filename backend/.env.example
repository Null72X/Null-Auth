# Server
PORT=5000
NODE_ENV=development   # change to production in real deployment

# Supabase Transaction Pooler URL (Port 6543)
# Replace with your actual pooler URL, but DO NOT commit real credentials.
DATABASE_URL="postgresql://postgres.your_project_ref:YOUR_SUPABASE_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Admin Authentication Secrets
JWT_SECRET=your_super_secret_jwt_key_change_this
JWT_EXPIRES_IN=24h

# Initial Admin Credentials (use dummy values for example)
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=change_me

# CORS Configuration
CORS_ORIGIN=http://localhost:3000   # or your frontend URL
