# Null-Auth Backend Environment Configuration

PORT=5000
NODE_ENV=production

# Supabase PostgreSQL Connection URL
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres"

# Admin Authentication Secrets
JWT_SECRET=change_this_to_a_secure_random_32_character_string_in_production
JWT_EXPIRES_IN=24h

# Initial Admin Credentials (used during npm run seed)
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=NullAuthAdminPassword2026!

# CORS Configuration (Set to your Vercel Frontend URL)
CORS_ORIGIN=https://null-auth.vercel.app
